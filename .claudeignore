# ==============================================================================
# .claudeignore - Claude Code Token Optimization & Exclusion Rules
# Premier League Model App
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Bağımlılıklar ve Build Çıktıları (Dependencies & Build Artifacts)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
dist/
*/dist/
frontend/dist/
build/
target/
bin/
obj/
.gradle/
.Python
env/
venv/
.venv/
ENV/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 2. Lock Dosyaları (Large Lockfiles that bloat context)
# ------------------------------------------------------------------------------
package-lock.json
*/package-lock.json
frontend/package-lock.json
pnpm-lock.yaml
yarn.lock
uv.lock
poetry.lock
Pipfile.lock

# ------------------------------------------------------------------------------
# 3. Test ve Kapsam Çıktıları (Test & Coverage Artifacts)
# ------------------------------------------------------------------------------
coverage/
*.lcov
test-results/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------------------------------------------
# 4. Loglar ve DB Dosyaları (Logs & Databases)
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.sqlite
*.sqlite3
*.db
data/premier_league.db

# ------------------------------------------------------------------------------
# 5. Projeye Özel Büyük Veri ve Ham Dosyalar (Large Project Data & Raw Files)
# binlerce JSON dosyası ve multi-MB veri setlerinin context'i şişirmesini engeller
# ------------------------------------------------------------------------------
data/raw/matches/
data/raw/matches/*
data/raw/*.json
data/processed/*.parquet
data/processed/player_match_logs.json
*.parquet

# ------------------------------------------------------------------------------
# 6. Eğitilmiş Model Ağırlıkları ve İkili Çıktılar (Binary Model Weights)
# Metin olarak okunamayan ikili (binary) modeller
# ------------------------------------------------------------------------------
models/backup/
models/production/*.joblib
models/**/*.joblib
*.joblib
*.pkl
*.pickle
*.onnx

# ------------------------------------------------------------------------------
# 7. Python Önbellek ve Derleme Dosyaları (Python Bytecode & Caches)
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------------------------
# 8. Sistem ve IDE Dosyaları (System & IDE Metadata)
# ------------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.env
.env.local
.env.*.local
